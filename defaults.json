{
  "schemaVersion": 1,
  "minSdkVersion": "0.45.0",
  "providerId": "WorkBuddy",
  "displayName": "WorkBuddy",
  "meta": {
    "version": "1.0.0",
    "author": "UsageMonitor",
    "description": "Query WorkBuddy (CodeBuddy) credits usage (subscription plan quota / gift packages / request history)",
    "iconFile": "assets/workbuddy-icon.png",
    "iconUrl": "https://download.codebuddy.cn/web/workbuddy/39aa83f6eb1effda3c999259e7db691102ff873f/assets/workbuddy-icon-BujKiC6G.svg",
    "iconUrlDark": "https://download.codebuddy.cn/web/workbuddy/39aa83f6eb1effda3c999259e7db691102ff873f/assets/workbuddy-icon-BujKiC6G.svg"
  },
  "credentialDomains": [ "workbuddy.cn" ],
  "metadata": {
    "supportedBuckets": [ "hour", "day", "week", "month" ],
    "fallbackBucket": "day",
    "supportedTables": [ 1 ],
    "availableSlicerFields": [ "model_name", "channel", "operation" ]
  },
  "loginConfig": {
    "loginUrl": "https://www.workbuddy.cn/login/",
    "cookieDomainFilters": [ "workbuddy.cn", "www.workbuddy.cn" ],
    "loginTimeout": "00:03:00",
    "uiButtonText": "i18n:plugin.WorkBuddy.login.button",
    "validateUrl": "https://www.workbuddy.cn/profile/plans-usage",
    "requiredCookieDomain": "workbuddy.cn",
    "requiredCookieNames": [ "session", "session_2" ],
    "loginUrlKeywords": [ "login", "signin", "sign-in" ],
    "loginSuccessHost": "www.workbuddy.cn",
    "loggedInPathKeywords": [ "/profile", "/console", "/plans-usage" ]
  },
  "configFields": [
    { "key": "BackfillDays", "displayName": "i18n:plugin.WorkBuddy.field.BackfillDays.name", "fieldType": "Number", "isRequired": false, "defaultValue": "7", "placeholder": "i18n:plugin.WorkBuddy.field.BackfillDays.placeholder" }
  ],
  "errorGuidance": [
    { "matchCodes": [ "credential_missing", "config_missing" ], "matchKeywords": [], "message": "i18n:plugin.WorkBuddy.guidance.credential" },
    { "matchCodes": [ "auth_invalid", "data_empty" ], "matchKeywords": [ "401", "403", "login" ], "message": "i18n:plugin.WorkBuddy.guidance.authInvalid" },
    { "matchCodes": [ "network_unreachable", "network_error", "timeout" ], "matchKeywords": [], "message": "i18n:plugin.WorkBuddy.guidance.networkUnreachable" },
    { "matchKeywords": [], "message": "i18n:plugin.WorkBuddy.guidance.fallback" }
  ],
  "usageUrls": {
    "zh-CN": "https://www.workbuddy.cn/profile/plans-usage",
    "en-US": "https://www.workbuddy.cn/profile/plans-usage"
  },
  "fetch": {
    "capture": {
      "navigateUrl": "https://www.workbuddy.cn/profile/plans-usage",
      "cookieDomain": ".workbuddy.cn"
    },
    "endpoints": [
      {
        "urlMatch": "get-user-resource",
        "mode": "http",
        "method": "POST",
        "urlTemplate": "https://www.workbuddy.cn/billing/meter/get-user-resource",
        "headers": {
          "Cookie": "{cookieHeader}",
          "Content-Type": "application/json",
          "x-client-platform": "web",
          "Referer": "https://www.workbuddy.cn/profile/plans-usage",
          "Origin": "https://www.workbuddy.cn"
        },
        "bodyTemplate": "{\"PageNumber\":1,\"PageSize\":200,\"ProductCode\":\"p_tcaca\",\"Status\":[0,3],\"OnlyValidPeriod\":true}",
        "finds": [
          {
            "itemsPath": "$.data.Response.Data.Accounts",
            "matchField": "SubProductName",
            "matchValue": "腾讯云代码助手 (IDE)",
            "fields": [
              { "path": "$.CapacitySizePrecise", "target": "total_credits", "transform": "parseNumber" },
              { "path": "$.CapacityRemainPrecise", "target": "remaining_credits", "transform": "parseNumber" },
              // Stage-5：per-account CapacityUsedPrecise 不再写到 used_credits（避免被 fields 块 TotalDosage 覆盖）；
              // used_credits 现只表示全局总消耗量（TotalDosage）。per-account 用量仍经 quota_rows.used 字段名保留。
              { "path": "$.PackageName", "target": "subscription_tier", "transform": "trim" },
              { "path": "$.CycleStartTime", "target": "quota_period_start_at", "transform": "parseDateTime" },
              { "path": "$.CycleEndTime", "target": "quota_period_end_at", "transform": "parseDateTime" }
            ]
          }
        ],
        "fields": [
          { "path": "$.data.Response.Data.TotalDosage", "target": "used_credits", "transform": "parseNumber" }
        ],
        "arrays": [
          {
            "itemsPath": "$.data.Response.Data.Accounts",
            "mode": "objects",
            "target": "quota_rows",
            "itemFields": [
              { "literalValue": "purchase", "target": "quota_type" },
              { "path": "$.PackageName", "target": "display_name", "transform": "trim" },
              { "path": "$.CapacitySizePrecise", "target": "limit", "transform": "parseNumber" },
              { "path": "$.CapacityRemainPrecise", "target": "remaining", "transform": "parseNumber" },
              { "path": "$.CapacityUsedPrecise", "target": "used", "transform": "parseNumber" },
              { "path": "$.CycleEndTime", "target": "expires_at", "transform": "parseDateTime" }
            ]
          }
        ]
      },
      // X-15 account_display_name 已下线（2026-08-13）：原 console/accounts endpoint 仅产出该字段，
      // 现移除以避免孤儿 endpoint。账号显示名改由 AccountCustomization.Nickname 用户账号字典提供。
      {
        "urlMatch": "get-user-request-usage",
        "mode": "http",
        "method": "POST",
        "urlTemplate": "https://www.workbuddy.cn/billing/meter/get-user-request-usage",
        "headers": {
          "Cookie": "{cookieHeader}",
          "Content-Type": "application/json",
          "x-client-platform": "web",
          "Referer": "https://www.workbuddy.cn/profile/plans-usage",
          "Origin": "https://www.workbuddy.cn"
        },
        "bodyTemplate": "{\"pageNum\":1,\"pageSize\":200,\"startTime\":\"{now:dateDay-6d}\",\"endTime\":\"{now:dateEnd}\"}",
        "pagination": {
          "mode": "timeWindow",
          "itemsProperty": "$.data.data",
          "pageParam": "pageNum",
          "pageSizeParam": "pageSize",
          "pageSize": 200,
          "windowStartParam": "startTime",
          "windowEndParam": "endTime",
          "windowTimeFormat": "yyyy-MM-dd HH:mm:ss",
          "windowSpanDays": 7,
          "backfillDaysTemplate": "{config:BackfillDays}",
          "maxPages": 30,
          "maxPagesTemplate": "{config:MaxPages}",
          "stopWhenKnownField": "requestId"
        },
        "arrays": [
          {
            "itemsPath": "$.data.data",
            "mode": "objects",
            "target": "request_detail",
            "itemFields": [
              { "path": "$.requestId", "target": "request_id", "transform": "trim" },
              { "path": "$.requestTime", "target": "occurred_at", "transform": "trim" },
              { "path": "$.client", "target": "channel", "transform": "trim" },
              { "path": "$.model", "target": "model", "transform": "trim" },
              { "path": "$.agentPurpose", "target": "operation", "transform": "trim" },
              { "path": "$.credit", "target": "credits", "transform": "parseNumber" }
            ]
          }
        ]
      }
    ],
    "computed": [
      { "target": "used_percent", "op": "percentOf", "operands": [ "used_credits", "total_credits" ], "whenPresent": "total_credits" },
      // X-8 subscription_active 已下线（2026-08-13）：从 computed 段移除。
      { "target": "today_used_credits", "op": "sumRequestDetail", "column": "credits", "window": "1d" }
    ]
  },
  "card": {
    "renderKinds": [ "subscriptionTitle", "primaryBar", "summary", "charts" ],
    "primaryMetric": "used_percent",
    "collapseDividerIndex": 7,
    "trayTooltip": {
      "rows": [
        { "fieldName": "__provider_name__" },
        { "kind": "bar", "chartRef": "wb.chart.quota_bar" },
        { "fieldName": "__refresh_countdown__" }
      ]
    },
    "baseInfo": {
      "fields": [
        { "fieldName": "subscription_tier", "role": "Meta" },
        // X-15 account_display_name 已下线（2026-08-13）：baseInfo.fields 中 Meta 角色声明同步移除。
        { "fieldName": "quota_period_end_at", "role": "Reset" }
      ]
    },
    "charts": [
      {
        "chartId": "wb.chart.quota_bar",
        "display": "i18n:plugin.WorkBuddy.chart.quotaUsage",
        "kind": "Bar",
        "defaultOrder": 2,
        "slicer": { "mode": "DataGroup", "interaction": "Scroll", "default": "sdk.template.usagePercent" },
        "tooltip": { "fields": [ "__field_name__", "used_percent", "used_credits", "total_credits", "remaining_credits" ] },
        "colorTiers": { "ref": "global:usage-tier-default" },
        "dataGroups": [
          {
            "id": "sdk.template.usagePercent",
            "display": "i18n:plugin.WorkBuddy.chart.quotaUsage",
            "fields": [
              { "fieldName": "used_percent", "role": "Value" },
              { "fieldName": "quota_period_end_at", "role": "Reset" }
            ]
          }
        ]
      },
      {
        "chartId": "wb.chart.credits_number",
        "display": "i18n:plugin.WorkBuddy.chart.overview",
        "kind": "Number",
        "defaultOrder": 1,
        "tooltip": { "fields": [ "remaining_credits", "total_credits", "used_credits", "quota_period_end_at" ] },
        "dataGroups": [
          { "id": "sdk.template.creditsBalance", "display": "i18n:plugin.WorkBuddy.group.planRemaining", "fields": [ { "fieldName": "remaining_credits", "role": "Value" } ] },
          { "id": "sdk.template.totalCredits", "display": "i18n:plugin.WorkBuddy.group.planLimit", "fields": [ { "fieldName": "total_credits", "role": "Value" } ] },
          { "id": "sdk.template.usedCredits", "display": "i18n:plugin.WorkBuddy.group.totalUsed", "fields": [ { "fieldName": "used_credits", "role": "Value" } ] },
          { "id": "sdk.template.todayUsedCredits", "display": "i18n:plugin.WorkBuddy.group.todayUsed", "fields": [ { "fieldName": "today_used_credits", "role": "Value" } ] }
        ]
      },
      {
        "chartId": "wb.chart.daily_credits",
        "display": "i18n:plugin.WorkBuddy.chart.dailyCredits",
        "kind": "StackedBar",
        "defaultOrder": 3,
        "detailGroupBy": "model",
        "detailValueField": "credits",
        "detailOp": "sum",
        "lookbackDays": 30,
        "slicer": {
          "mode": "Period",
          "position": "TopRight",
          "interaction": "Button",
          "timeRanges": [ "Last7Days", "Last15Days", "Last30Days" ],
          "default": "Last7Days"
        },
        "dataGroups": [
          { "id": "sdk.template.dailyCredits", "display": "i18n:plugin.WorkBuddy.group.dailyCreditsModel", "fields": [
            { "fieldName": "daily_used_credits", "role": "Value" }
          ] }
        ]
      },
      {
        "chartId": "wb.chart.daily_operation",
        "display": "i18n:plugin.WorkBuddy.chart.dailyOperation",
        "kind": "StackedBar",
        "defaultOrder": 4,
        "detailGroupBy": "operation",
        "detailValueField": "credits",
        "detailOp": "sum",
        "lookbackDays": 30,
        "seriesDisplayNames": {
          "conversation": "i18n:plugin.WorkBuddy.series.conversation",
          "subagent:Explore": "i18n:plugin.WorkBuddy.series.subagentExplore",
          "subagent": "i18n:plugin.WorkBuddy.series.subagent"
        },
        "colors": [ "#2ADB5C", "#1A88FF", "#FFC104", "#FF810C", "#7C4DFF" ],
        "slicer": {
          "mode": "Period",
          "position": "TopRight",
          "interaction": "Button",
          "timeRanges": [ "Last7Days", "Last15Days", "Last30Days" ],
          "default": "Last7Days"
        },
        "dataGroups": [
          { "id": "wb.stack.operation", "display": "i18n:plugin.WorkBuddy.group.dailyOperationModel", "fields": [
            { "fieldName": "daily_used_credits", "role": "Value" }
          ] }
        ]
      },
      {
        "chartId": "wb.chart.request_count",
        "display": "i18n:plugin.WorkBuddy.chart.requestCount",
        "kind": "StackedBar",
        "defaultOrder": 5,
        "detailGroupBy": "model",
        "detailValueField": "request_id",
        "detailOp": "count",
        "lookbackDays": 30,
        "colors": [ "#2ADB5C", "#1A88FF", "#FFC104", "#FF810C", "#7C4DFF", "#00BFA5" ],
        "slicer": {
          "mode": "Period",
          "position": "TopRight",
          "interaction": "Button",
          "timeRanges": [ "Last7Days", "Last15Days", "Last30Days" ],
          "default": "Last7Days"
        },
        "dataGroups": [
          { "id": "wb.stack.request_count", "display": "i18n:plugin.WorkBuddy.group.requestCountModel", "fields": [
            { "fieldName": "request_count", "role": "Value" }
          ] }
        ]
      },
      {
        "chartId": "wb.chart.creditsTrend",
        "display": "i18n:plugin.WorkBuddy.chart.creditsTrend",
        "kind": "Curve",
        "defaultOrder": 6,
        "detailGroupBy": "model",
        "detailValueField": "credits",
        "detailOp": "sum",
        "lookbackDays": 30,
        "colors": [ "#2ADB5C", "#1A88FF", "#FFC104" ],
        "slicer": {
          "mode": "Period",
          "position": "TopRight",
          "interaction": "Button",
          "timeRanges": [ "Last7Days", "Last15Days", "Last30Days" ],
          "default": "Last7Days"
        },
        "dataGroups": [
          { "id": "sdk.template.dailyCredits", "display": "i18n:plugin.WorkBuddy.group.creditsTrendModel", "fields": [
            { "fieldName": "daily_used_credits", "role": "Value" }
          ] }
        ]
      },
      {
        "chartId": "wb.chart.creditsTrendRolling",
        "display": "i18n:plugin.WorkBuddy.chart.creditsTrendRolling",
        "kind": "Curve",
        "defaultOrder": 7,
        "detailGroupBy": "model",
        "detailValueField": "credits",
        "detailOp": "sum",
        "rollingWindowDays": 7,
        "lookbackDays": 30,
        "colors": [ "#2ADB5C" ],
        "slicer": {
          "mode": "Period",
          "position": "TopRight",
          "interaction": "Button",
          "timeRanges": [ "Last7Days", "Last15Days", "Last30Days" ],
          "default": "Last7Days"
        },
        "dataGroups": [
          { "id": "sdk.template.dailyCredits", "display": "i18n:plugin.WorkBuddy.group.creditsTrendRollingModel", "fields": [
            { "fieldName": "daily_used_credits", "role": "Value" }
          ] }
        ]
      },
      {
        "chartId": "wb.chart.usedPercentTrend",
        "display": "i18n:plugin.WorkBuddy.chart.usedPercentTrend",
        "kind": "Curve",
        "defaultOrder": 8,
        "slicer": {
          "mode": "Period",
          "position": "TopRight",
          "interaction": "Button",
          "timeRanges": ["Last7Days", "Last15Days", "Last30Days"],
          "default": "Last30Days"
        },
        "tooltip": { "fields": ["__date__", "used_percent"] },
        "dataGroups": [{
          "id": "sdk.template.usagePercent",
          "fields": [
            { "fieldName": "recorded_at", "role": "Meta" },
            { "fieldName": "used_percent", "role": "Value" }
          ]
        }]
      },
      {
        "chartId": "wb.chart.remainingCreditsTrend",
        "display": "i18n:plugin.WorkBuddy.chart.remainingCreditsTrend",
        "kind": "Curve",
        "defaultOrder": 9,
        "slicer": {
          "mode": "Period",
          "position": "TopRight",
          "interaction": "Button",
          "timeRanges": ["Last7Days", "Last15Days", "Last30Days"],
          "default": "Last30Days"
        },
        "tooltip": { "fields": ["__date__", "remaining_credits"] },
        "dataGroups": [{
          "id": "sdk.template.creditsBalance",
          "fields": [
            { "fieldName": "recorded_at", "role": "Meta" },
            { "fieldName": "remaining_credits", "role": "Value" }
          ]
        }]
      }
    ]
  },
  "taskbar": {
    "baseInfo": {
      "fields": [
        { "fieldName": "subscription_tier", "role": "Meta" },
        { "fieldName": "quota_period_end_at", "role": "Reset" }
      ]
    },
    "miniCharts": [
      {
        "chartId": "wb.mini.ring",
        "display": "i18n:plugin.WorkBuddy.mini.ring",
        "kind": "MiniRingChart",
        "slicer": { "mode": "DataGroup", "interaction": "Scroll", "default": "wb.mini.remaining" },
        "tooltip": { "fields": [ "__provider_name__", "remaining_credits", "total_credits", "__refresh_countdown__" ] },
        "colorTiers": { "ref": "global:usage-tier-default" },
        "dataGroups": [
          { "id": "wb.mini.remaining", "display": "i18n:plugin.WorkBuddy.group.taskbarRemaining", "fields": [
            { "fieldName": "remaining_credits", "role": "Value" },
            { "fieldName": "total_credits", "role": "Upper" }
          ] },
          { "id": "sdk.template.usagePercent", "display": "i18n:plugin.WorkBuddy.group.taskbarPlan", "fields": [
            { "fieldName": "used_percent", "role": "Value" }
          ] }
        ]
      },
      {
        "chartId": "wb.mini.text",
        "display": "i18n:plugin.WorkBuddy.mini.text",
        "kind": "MiniText",
        "slicer": { "mode": "DataGroup", "interaction": "Scroll", "default": "sdk.template.usagePercent" },
        "tooltip": { "fields": [ "__provider_name__", "used_percent", "__refresh_countdown__" ] },
        "dataGroups": [
          { "id": "sdk.template.usagePercent", "display": "i18n:plugin.WorkBuddy.group.taskbarPlan", "fields": [ { "fieldName": "used_percent", "role": "Value" } ] },
          { "id": "sdk.template.todayUsedCredits", "display": "i18n:plugin.WorkBuddy.group.taskbarTodayUsed", "fields": [ { "fieldName": "today_used_credits", "role": "Value" } ] }
        ]
      }
    ]
  }
}
